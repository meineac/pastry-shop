# ---------------------------------------------------------------------------
# Pastry Shop — environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ---------------------------------------------------------------------------

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Set to False when running behind no HTTPS proxy (e.g. local Docker without Nginx)
SECURE_SSL_REDIRECT=True

# Database (PostgreSQL for Docker/Render; SQLite used when variable is absent)
DATABASE_URL=postgres://pastry_user:pastry_password@localhost:5432/pastry_shop

# Third-party APIs
# Get a free token at https://ipinfo.io/
IPINFO_TOKEN=your-ipinfo-token-here

# Get a free API key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-api-key-here

# Logging (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=DEBUG

# Fallback public IP used when request comes from localhost (127.0.0.1).
# Replace with any public IP to test a different location in development.
TEST_IP=8.8.8.8

# Superuser created by `python manage.py seed_all`
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=adminpass
